# MedService frontend (Next.js dashboard) — production env.
# Copy to .env on the server (gitignored) and fill in real values.
# docker-compose.prod.yml reads these for the build ARG and the Caddy service.

# Public API base URL baked into the CLIENT bundle at BUILD time. MUST be the
# public HTTPS API domain — never localhost. An empty value fails the build
# (see Dockerfile) instead of silently shipping http://localhost:8000.
NEXT_PUBLIC_API_URL=https://api.example.com

# Domains served by Caddy (edge). Real DNS must point at this host; 80/443 open.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# A real address — Let's Encrypt/ACME registration uses it.
ACME_EMAIL=ops@example.com

# Where Caddy reverse-proxies the API domain (the backend host:port, which may
# be a private address on another server).
BACKEND_PRIVATE_HOST=10.0.0.6
BACKEND_PRIVATE_PORT=8000

# Patient mini-app domain (served by the mini service — see medservice-mini).
MINI_DOMAIN=mini.example.com
