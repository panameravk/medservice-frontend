# MedService frontend (Next.js dashboard) — production env.
# Copy to .env on the server (gitignored) and fill in real values.
# docker-compose.prod.yml reads these for the build ARG and the Caddy service.

# Public API base URL baked into the CLIENT bundle at BUILD time (and into the
# mini bundle as VITE_API_URL). MUST be the public HTTPS API domain — never
# localhost. An empty value fails the build (see Dockerfile).
# DNS этого домена указывает на БЭКЕНД-сервер (там свой Caddy с TLS).
NEXT_PUBLIC_API_URL=https://api.example.com

# Domains served by Caddy on THIS host. Real DNS must point here; 80/443 open.
APP_DOMAIN=app.example.com
# Patient mini-app domain (served by the mini service — see medservice-mini).
MINI_DOMAIN=mini.example.com
# A real address — Let's Encrypt/ACME registration uses it.
ACME_EMAIL=ops@example.com
